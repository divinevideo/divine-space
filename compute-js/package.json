{
  "name": "divine-space-compute",
  "version": "0.1.0",
  "description": "DiVine Space - MySpace-inspired profile builder",
  "type": "module",
  "devDependencies": {
    "@fastly/cli": "^11.2.0",
    "@fastly/compute-js-static-publish": "^7.0.3"
  },
  "dependencies": {
    "@fastly/js-compute": "^3.26.0"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "private": true,
  "scripts": {
    "build": "js-compute-runtime ./src/index.js ./bin/main.wasm",
    "deploy": "npm run publish-content && npm run build && fastly compute publish",
    "dev:local": "npm run publish-local && fastly compute serve",
    "publish-local": "npx @fastly/compute-js-static-publish publish-content --local",
    "publish-content": "npx @fastly/compute-js-static-publish publish-content"
  }
}
